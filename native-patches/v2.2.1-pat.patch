+//! Structured pat identities; display templates are never used as identities.
+use serde::{Deserialize, Serialize};
+use ts_rs::TS;
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize, TS, schemars::JsonSchema)]
+#[serde(rename_all = "camelCase")]
+pub struct PatInfo {
+    /// WeChat username of the member who initiated the pat.
+    pub actor_id: String,
+    /// WeChat username of the member who was patted.
+    pub target_id: String,
+}
+
+pub(crate) fn body(content: &str) -> &str {
+    match content.split_once(":\n") {
+        Some((prefix, rest)) if prefix.len() <= 512 && rest.trim_start().starts_with('<') => rest,
+        _ => content,
+    }
+}
+
+fn identifier(node: roxmltree::Node<'_, '_>, name: &str) -> Option<String> {
+    let value = crate::quotes::leaf(crate::quotes::child(node, name)?)?;
+    if value.is_empty() || value.len() > 512 || value.chars().any(char::is_whitespace)
+        || value.chars().any(char::is_control) || value.ends_with("@chatroom") {
+        return None;
+    }
+    Some(value)
+}
+
+pub(crate) fn parse(kind: i32, content: &str, thread: &str) -> Option<PatInfo> {
+    if !matches!(kind, 49 | 10000 | 10002) || !thread.ends_with("@chatroom")
+        || content.len() > 128 * 1024 {
+        return None;
+    }
+    let doc = roxmltree::Document::parse_with_options(body(content), roxmltree::ParsingOptions {
+        allow_dtd: false, nodes_limit: 256, ..Default::default()
+    }).ok()?;
+    if doc.descendants().any(|n| n.ancestors().take(18).count() > 16
+        || (n.is_element() && n.tag_name().namespace().is_some())
+        || n.attributes().any(|a| a.namespace().is_some())) {
+        return None;
+    }
+    let root = doc.root_element();
+    let pat = if matches!(kind, 10000 | 10002) {
+        if root.tag_name().name() != "sysmsg" || root.attribute("type") != Some("pat") {
+            return None;
+        }
+        let node = crate::quotes::child(root, "pat")?;
+        let chat = crate::quotes::leaf(crate::quotes::child(node, "chatusername")?)?;
+        if chat != thread { return None; }
+        PatInfo { actor_id: identifier(node, "fromusername")?,
+            target_id: identifier(node, "pattedusername")? }
+    } else {
+        let app = if root.tag_name().name() == "appmsg" { root }
+            else if root.tag_name().name() == "msg" { crate::quotes::child(root, "appmsg")? }
+            else { return None; };
+        if crate::quotes::leaf(crate::quotes::child(app, "type")?)? != "62" { return None; }
+        let records = crate::quotes::child(crate::quotes::child(app, "patMsg")?, "records")?;
+        let record = crate::quotes::child(records, "record")?;
+        PatInfo { actor_id: identifier(record, "fromUser")?,
+            target_id: identifier(record, "pattedUser")? }
+    };
+    if let Some((prefix, _)) = content.split_once(":\n") {
+        if prefix != thread && prefix != pat.actor_id { return None; }
+    }
+    Some(pat)
+}
